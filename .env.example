NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_dev
LOG_LEVEL=debug

# The API port again, under a name the web dev server can trust. `PORT` means
# "the port this process listens on" to every process manager there is, so
# anything that launches Vite may set it to Vite's own port. Vite reads this to
# decide where to proxy `/v1`, and reading `PORT` there made it proxy to itself.
# Keep it equal to PORT above. `npm run dev` overrides both together, so they
# stay in step even when it has to move the API off a busy 3000.
API_PORT=3000

# The Vite dev server's own port, and only a preference: `npm run dev` scans up
# from here for a free one. Leave it out and the scan starts at Vite's own 5173.
# Nothing outside the dev launcher reads it.
# WEB_PORT=5173

# Integration tests truncate this database between cases. Never point it at a
# database with data you want. It is created automatically if it does not exist.
TEST_DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_test

# Transactional mail for invites and password resets. "log" writes the message
# to the log instead of sending it, which is what you want in development.
EMAIL_PROVIDER=log
EMAIL_FROM=kelpie@example.com

# Seals secrets the service must be able to read back, unlike a password or an
# API key: a webhook signing secret is what each delivery's `Kelpie-Signature`
# is computed with, so it is stored encrypted rather than hashed. Generate one
# with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every secret sealed under the old one unreadable.
SECRET_ENCRYPTION_KEY=
