# Kelpie environment variables
#
# `kelpie.config.ts` is the source of truth for the service configuration.
# Each leaf marked `fromEnv(...)` can be overridden by the variable below.
# Anything not marked `fromEnv` is a literal and needs a code change.
#
# `.env.local` is loaded before `.env` and wins. A shell variable beats both.

# ---- Core ------------------------------------------------------------------

# One of `development`, `test`, `production`.
# Config field: runtimeMode
NODE_ENV=development

# Port the API listens on.
# Config field: port
PORT=3000

# Postgres connection string. `make up` writes the Docker-assigned URL to
# `.env.local`, which overrides this value.
# Config field: databaseUrl
DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_dev

# One of `debug`, `info`, `warn`, `error`.
# Config field: logLevel
LOG_LEVEL=debug

# ---- Dev launcher (not read by the API) ------------------------------------

# Port the Vite dev server proxies API requests to. Keep equal to PORT.
# Read by: apps/kelpie/vite.config.ts (dev only)
API_PORT=3000

# Port the Vite dev server listens on. Optional. Defaults to 5173.
# Read by: apps/kelpie/src/dev.ts (dev only)
# WEB_PORT=5173

# ---- Web bundle ------------------------------------------------------------

# Directory holding the built web bundle, served by the API process. Leave
# unset in development, where Vite serves pages and proxies /v1 to the API.
# Set in production after `npm run build`.
# Config field: webBundleDirectory
# WEB_BUNDLE_DIR=./apps/kelpie/dist/web

# ---- Email -----------------------------------------------------------------

# `log` writes messages to the console. `smtp` sends through the server below.
# Config field: email.provider
EMAIL_PROVIDER=log

# From address for all transactional mail (invites, password resets).
# Config field: email.from
EMAIL_FROM=kelpie@example.com

# Required when EMAIL_PROVIDER=smtp. Ignored otherwise.
# `SMTP_SECURE=true` for TLS on connect (port 465).
# `SMTP_SECURE=false` for STARTTLS upgrade (port 587).
# Config fields: email.smtp.host, .port, .secure, .user, .password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Rate limits -----------------------------------------------------------

# Request count and window (seconds) per budget. Defaults shown.
# Config fields: rateLimit.forms, .auth, .loginAccount, .api
# RATE_LIMIT_FORMS_LIMIT=20
# RATE_LIMIT_FORMS_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
# RATE_LIMIT_API_LIMIT=600
# RATE_LIMIT_API_WINDOW_SECONDS=60

# ---- App base URL ----------------------------------------------------------

# Base URL where the browser reaches the app. Every emailed link (invite,
# password reset, email verification) is built from it. Required.
# Config field: appBaseUrl
APP_BASE_URL=http://localhost:5173

# ---- Secret encryption -----------------------------------------------------

# Encryption key for stored secrets (webhook signing keys, agent-task auth
# headers). Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Config field: secretEncryption.key
SECRET_ENCRYPTION_KEY=

# The key being rotated away from. Set during rotation only. See `npm run
# reseal` in README.md.
# Config field: secretEncryption.previousKey
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# ---- Trusted proxies -------------------------------------------------------

# Number of reverse proxies in front of the service. 0 means direct access.
# Set to the actual hop count so the rate limiter reads the real client IP
# from X-Forwarded-For.
# Config field: trustedProxyHopCount
# TRUSTED_PROXY_HOP_COUNT=0

# ---- Module config file ----------------------------------------------------

# Path to a JSON file that locks modules on or off for every workspace.
# See kelpie.modules.json.example. Leave unset to let each workspace decide.
# Config field: moduleConfigPath
# KELPIE_MODULE_CONFIG_PATH=

# Human-readable name of this install ("dev", "demo", "cloud", or whatever
# you pick). Shown at the top of the UI when NODE_ENV is not `production`,
# so multiple installs open side by side are easy to tell apart. Leave unset
# to have the runtime mode used as the label instead. Ignored on production.
# Config field: siteName
# KELPIE_SITE_NAME=dev

# ---- Module env keys -------------------------------------------------------
#
# These variables are read by individual modules through their own Zod schemas,
# not through kelpie.config.ts. You can lock any of them in code by adding an
# `env` section to kelpie.config.ts:
#
#   env: {
#     BLOCK_PRIVATE_EGRESS: 'true',
#     WEBHOOK_DELIVERY_RETENTION_DAYS: fromEnv('WEBHOOK_DELIVERY_RETENTION_DAYS', z.string()),
#   }

# Days of webhook delivery log to keep. Default 30.
# Read by: modules/webhooks (deliveryRetentionConfigSchema)
# WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Block outbound webhook and agent-task POSTs to private/reserved addresses.
# Default false. Enable in hosted deployments.
# Read by: modules/webhooks, modules/agent-tasks (egressConfigSchema)
# BLOCK_PRIVATE_EGRESS=false

# ---- Integration tests -----------------------------------------------------

# Test database. Truncated between test cases. Never point at real data.
# Created automatically if missing.
# Read by: packages/server/src/testing/environment.ts
TEST_DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_test
