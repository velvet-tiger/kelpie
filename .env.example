# Environment overrides for the assembly's config file.
#
# `apps/kelpie/kelpie.config.ts` is the source of truth for the service's
# configuration: it declares the shape, the defaults, and which leaves the
# environment may fill in.
#
# Every leaf in that file marked `fromEnv(...)` can be overridden by the
# matching variable below. Anything not marked `fromEnv` is a literal committed
# to git and cannot be changed without a code change. Modules that read their
# own env keys via `context.config(schema)` are listed further down.
#
# `.env.local` is read before `.env`, so a local override wins. A real
# environment variable set in the shell beats both.

# ---- Core ------------------------------------------------------------------

# The runtime mode. `development` and `test` are for local work; `production`
# tightens a handful of defaults (see `lib/logger.ts` and the auth module).
# Kelpie.config.ts field: `runtimeMode`.
NODE_ENV=development

# The port the API binds. In development, `npm run dev` scans up from this
# number for a free one and passes the winner to the API child, but the API
# itself always binds exactly what it is given and fails on `EADDRINUSE`.
# Kelpie.config.ts field: `port`.
PORT=3000

# The Postgres connection string. `make up` runs Postgres in Docker on whatever
# port Docker had free and writes that URL to `.env.local`, which wins over
# this file. The value here is what you get when you run your own Postgres.
# Kelpie.config.ts field: `databaseUrl`.
DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_dev

# Log verbosity. One of `debug`, `info`, `warn`, `error`.
# Kelpie.config.ts field: `logLevel`.
LOG_LEVEL=debug

# ---- Dev launcher (not read by the API) ------------------------------------

# The API port again, under a name the web dev server can trust. `PORT` means
# "the port this process listens on" to every process manager, so anything
# that launches Vite may set it to Vite's own port. Vite reads this to decide
# where to proxy `/v1`; reading `PORT` there made Vite proxy to itself.
# Keep it equal to PORT above. `npm run dev` overrides both together, so they
# stay in step even when it has to move the API off a busy port.
# Read by: `apps/kelpie/vite.config.ts` (dev only). No `kelpie.config.ts` field.
API_PORT=3000

# The Vite dev server's own port, and only a preference: `npm run dev` scans
# up from here for a free one. Leave it out and the scan starts at Vite's own
# 5173. Read by: `apps/kelpie/src/dev.ts` (dev only). No `kelpie.config.ts` field.
# WEB_PORT=5173

# ---- Web bundle ------------------------------------------------------------

# Directory holding the built web bundle, served from the same origin as the
# API. Unset in development, where Vite serves the pages and proxies `/v1`
# here. Set in a deployment, where nothing else would serve the built pages.
# Kelpie.config.ts field: `webBundleDirectory`.
# WEB_BUNDLE_DIR=./apps/kelpie/dist/web

# ---- Email -----------------------------------------------------------------

# Transactional mail for invites and password resets. `log` writes the message
# to the log instead of sending it, which is what you want in development.
# `smtp` sends for real, through the server and credentials below.
# Kelpie.config.ts field: `email.provider`.
EMAIL_PROVIDER=log

# From address for every transactional mail Kelpie sends.
# Kelpie.config.ts field: `email.from`.
EMAIL_FROM=kelpie@example.com

# Required only when EMAIL_PROVIDER=smtp; ignored otherwise. `SMTP_SECURE` is
# `true` for a server that expects TLS from the first byte (usually port 465)
# and `false` for one you connect to in plain text and upgrade with STARTTLS
# (usually port 587 or 25).
# Kelpie.config.ts fields: `email.smtp.host`, `.port`, `.secure`, `.user`, `.password`.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Rate limits (api.md) --------------------------------------------------

# Each pair is a request count and the window it resets over, in seconds.
# Leave them unset for the defaults shown; nothing here needs configuring to
# run. The login-account budget caps attempts on one address whatever IP they
# come from, which the IP budget alone cannot do.
# Kelpie.config.ts fields: `rateLimit.forms.limit` and `.windowSeconds`, and so on
# for `auth`, `loginAccount`, `api`.
# RATE_LIMIT_FORMS_LIMIT=20
# RATE_LIMIT_FORMS_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
# RATE_LIMIT_API_LIMIT=600
# RATE_LIMIT_API_WINDOW_SECONDS=60

# ---- Trusted proxies -------------------------------------------------------

# How many trusted proxies stand in front of the service. 0 (the default)
# means the service is reached directly and the client IP is the socket
# address. Behind a load balancer or ingress, set it to the number of hops so
# the rate limiter reads the real client IP from `X-Forwarded-For` rather than
# collapsing every caller into one bucket. Only raise it as far as proxies you
# actually control, since each hop is a header entry a caller could forge.
# Kelpie.config.ts field: `trustedProxyHopCount`.
# TRUSTED_PROXY_HOP_COUNT=0

# ---- Module override file --------------------------------------------------

# Locks specific toggleable modules on or off for every workspace this
# deployment serves, ahead of what a workspace's own settings screen says
# (README.md, "Turning modules on or off"). Copy `kelpie.modules.json.example`
# to `kelpie.modules.json`, edit it, and point this at the copy. Leave unset
# to let each workspace decide for itself, which is the ordinary case.
# Kelpie.config.ts field: `moduleConfigPath`.
# KELPIE_MODULE_CONFIG_PATH=

# ---- Module env keys (read via `context.config(schema)`) -------------------
#
# The variables below are not currently declared in `kelpie.config.ts`. Each
# module still parses its own slice of `process.env` through its Zod schema.
# You can lock any of them in code by adding an `env` section to
# `kelpie.config.ts`:
#
#   env: {
#     APP_BASE_URL: 'https://kelpie.example.com',            // literal, locked
#     SECRET_ENCRYPTION_KEY: fromEnv('SECRET_ENCRYPTION_KEY', z.string()),
#   }
#
# A key set in `env` overrides `process.env` for that key. A key unset there
# passes through unchanged, so the section is a progressive migration: lock
# what you want to lock, leave the rest.

# The deployment's own base URL, and where every emailed link points: password
# reset, email verification, and workspace invitations. The service builds each
# link from this rather than from anything the caller sends, so a stranger
# cannot aim a real Kelpie email at a link they control. Set it to where the
# browser reaches the app: the Vite dev server in development, your public URL
# in a deployment. Required.
# Read by: `modules/workspace` (`appUrlConfigSchema`).
APP_BASE_URL=http://localhost:5173

# Seals secrets the service must be able to read back, unlike a password or an
# API key: a webhook signing secret is what each delivery's `Kelpie-Signature`
# is computed with, so it is stored encrypted rather than hashed. Generate one
# with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Read by: `modules/webhooks`, `modules/agent-tasks` (`secretEncryptionConfigSchema`).
SECRET_ENCRYPTION_KEY=

# Only while rotating `SECRET_ENCRYPTION_KEY`. Set this to the old key, put
# the new one above, deploy, then run `npm run reseal`. Deliveries keep
# signing throughout: a stored secret is read with the current key, falling
# back to this one. Remove it once reseal reports nothing left to do.
#
# Rotating without it makes every secret sealed under the old key unreadable,
# and nothing can recover them.
# Read by: `modules/webhooks`, `modules/agent-tasks` (`secretEncryptionConfigSchema`).
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# How many days of webhook delivery log to keep. A webhook's expired rows are
# deleted when its next delivery is recorded. Whole number, at least one;
# leave it out for the default of 30.
# Read by: `modules/webhooks` (`deliveryRetentionConfigSchema`).
# WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Refuse outbound webhook and agent POSTs to private or reserved addresses
# (the cloud metadata service, localhost, internal ranges). Off by default,
# because a self-hosted Kelpie legitimately posts to internal automation. A
# hosted deployment sets it true and pairs it with network-level egress rules.
# Read by: `modules/webhooks`, `modules/agent-tasks` (`egressConfigSchema`).
# BLOCK_PRIVATE_EGRESS=false

# ---- Integration tests -----------------------------------------------------

# The integration test database. Tests truncate it between cases. Never point
# it at a database with data you want. It is created automatically if it does
# not exist.
# Read by: `packages/server/src/testing/environment.ts` (tests only).
TEST_DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie_test
