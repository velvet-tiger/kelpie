{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Source imports name `.ts` and `.tsx`; the emitted JS has to name `.js`. */
    "rewriteRelativeImportExtensions": true,

    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
