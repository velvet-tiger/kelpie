# Generated by `npm create kelpie`. Keep it out of version control.

NODE_ENV=development
LOG_LEVEL=info

# The API binds this exact port and fails if it is taken.
PORT=__PORT__

# The same number again, for the Vite dev server's proxy. It needs its own name
# because a process manager sets PORT to the port it wants Vite on, and Vite
# would then proxy to itself.
API_PORT=__PORT__

# The Vite dev server's own port.
WEB_PORT=__WEB_PORT__

DATABASE_URL=__DATABASE_URL__

# The address people reach this Kelpie on, used to build the links in emails
# (verification, password reset, invitations). In development that is the Vite
# dev server below; a deployment sets its real origin.
APP_BASE_URL=http://localhost:__WEB_PORT__

# Seals secrets the service reads back, such as webhook signing secrets. This
# one was generated for this project. Losing it makes those secrets unreadable;
# changing it needs the rotation procedure in README.md.
SECRET_ENCRYPTION_KEY=__SECRET_ENCRYPTION_KEY__

# EMAIL_PROVIDER picks a named sender the runtime resolves. `log` is a
# built-in that writes messages to the log instead of sending them; `smtp`
# comes from `@kelpie/module-smtp-email`, which reads the SMTP variables
# below. A different provider module (Resend, Postmark, …) registers its
# own name — set EMAIL_PROVIDER to that name to use it.
EMAIL_PROVIDER=log
EMAIL_FROM=__EMAIL_FROM__

# Read by `@kelpie/module-smtp-email` when EMAIL_PROVIDER=smtp. Ignored
# otherwise.
#
# SMTP_SECURE is "true" for a server that expects TLS from the first byte
# (usually port 465), "false" for one you connect to in plain text and that
# upgrades with STARTTLS (usually port 587 or 25).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
