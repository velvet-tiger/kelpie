# Generated by `npm create kelpie`. Keep it out of version control.

# `development` is for your own machine. A deployment must set `production`:
# in development mode the session cookie has no `Secure` flag.
NODE_ENV=development
LOG_LEVEL=info

# The API binds this exact port and fails if it is taken.
PORT=__PORT__

# The same number again, for the Vite dev server's proxy. It needs its own name
# because a process manager sets PORT to the port it wants Vite on, and Vite
# would then proxy to itself.
API_PORT=__PORT__

# The Vite dev server's own port.
WEB_PORT=__WEB_PORT__

DATABASE_URL=__DATABASE_URL__
__BUNDLED_DATABASE_ENV__
# The address people reach this Kelpie on, used to build the links in emails
# (verification, password reset, invitations). In development that is the Vite
# dev server below; a deployment sets its real origin.
APP_BASE_URL=http://localhost:__WEB_PORT__

# Seals secrets the service reads back, such as webhook signing secrets. This
# one was generated for this project. Losing it makes those secrets unreadable;
# changing it needs the rotation procedure in README.md.
SECRET_ENCRYPTION_KEY=__SECRET_ENCRYPTION_KEY__

# EMAIL_PROVIDER picks a named sender the runtime resolves. `log` is a
# built-in that writes messages to the log instead of sending them; `smtp`
# is the built-in `smtp-email` module in `@kelpie/server`, which reads the
# SMTP variables below. A different provider module (Resend, Postmark, …)
# registers its own name — set EMAIL_PROVIDER to that name to use it.
#
# `log` is for development. When NODE_ENV=production it writes no message
# body, so the log has no invitation or password-reset links, and the
# service warns at boot that no email is sent. EMAIL_LOG_BODY=true or false
# decides in every mode. With true in production, everybody who can read the
# log can use a link to sign in.
EMAIL_PROVIDER=log
# EMAIL_LOG_BODY=true
# One address, or a name and an address: Kelpie <kelpie@example.com>
EMAIL_FROM=__EMAIL_FROM__

# Read by the built-in `smtp-email` module when EMAIL_PROVIDER=smtp. Ignored
# otherwise.
#
# SMTP_SECURE is "true" for a server that expects TLS from the first byte
# (usually port 465), "false" for one you connect to in plain text and that
# upgrades with STARTTLS (usually port 587 or 25). The upgrade is required:
# a server that does not offer STARTTLS fails the send, so the password and
# the mail never go in plain text. A server on this machine (localhost, a
# .localhost name, a loopback address) is exempt, so a local catch-all works.
#
# SMTP_REQUIRE_TLS=false turns the rule off for a relay on a private network
# that you trust. SMTP_REQUIRE_TLS=true applies it to this machine too.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# Kelpie AI. Each workspace admin enters their own OpenAI or Anthropic key in
# Admin -> AI. Set these to give every workspace a fallback key instead. All
# optional; AI_API_KEY is ignored without AI_PROVIDER (`openai` or
# `anthropic`).
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
