{
  "name": "@kelpie/server",
  "version": "0.0.0",
  "description": "The Kelpie service as a library: module runtime, core CRM modules, REST API, MCP surface, and the shared migration pipeline.",
  "keywords": ["kelpie", "crm", "hono", "drizzle", "mcp", "agent"],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velvet-tiger/kelpie.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/velvet-tiger/kelpie/tree/main/packages/server#readme",
  "bugs": "https://github.com/velvet-tiger/kelpie/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "migrations"],
  "exports": {
    ".": {
      "kelpie-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "kelpie-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@kelpie/schemas": "^0.0.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
