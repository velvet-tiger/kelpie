{
  "name": "kelpie",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node apps/kelpie/src/dev.ts",
    "dev:processes": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev --workspace apps/kelpie\" \"npm run dev:web --workspace apps/kelpie\"",
    "build": "npm run build --workspaces --if-present",
    "verify:packaging": "node verify-packaging.ts",
    "release": "node release.ts",
    "publish:packages": "node publish.ts",
    "lint": "oxlint",
    "typecheck": "tsc --project tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "make up",
    "db:down": "make down",
    "db:generate": "npm run db:generate --workspace packages/server",
    "db:migrate": "npm run migrate --workspace apps/kelpie",
    "reseal": "npm run reseal --workspace apps/kelpie"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
