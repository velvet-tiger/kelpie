{
  "compilerOptions": {
    "target": "es2023",
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    /*
     * Workspace packages export both their TypeScript source and the JavaScript
     * they compile to. In here we want the source: `dist` is a build artifact
     * that is routinely absent or stale, and typechecking against a stale one
     * reports errors about code nobody wrote. Every runtime that loads this tree
     * asks for the same condition, so the toolchain and the type checker agree
     * on which file they are looking at.
     */
    "customConditions": ["kelpie-source"],

    /* Node strips types rather than compiling them; nothing non-erasable is allowed. */
    "erasableSyntaxOnly": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    /*
     * Separates "this property may be absent" from "this property may be
     * present and undefined". The scaffolder's templates have always set it, so
     * without it here the repository compiles code a generated project rejects,
     * which is how a broken `npm run typecheck` shipped in two releases.
     *
     * The UI already treats `undefined` as a value rather than an absence:
     * `undefined` means "not sent" and `null` means "clear the field", which is
     * what `definedFields` and `mergeDefined` are for. A property that accepts
     * it therefore declares `?: T | undefined` and says so.
     */
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
